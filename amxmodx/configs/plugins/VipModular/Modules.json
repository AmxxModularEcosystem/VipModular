[
    /*
        Настройка активности модулей при различных условиях.
        На данный момент проверка условий выполняется только при запуске карты.
    */

    {
        /*
            Modules - Список модулей, к которым будут применяться условия
            Limits - Условия, при выполнении которых модули будут активны
        */
        
        "Modules": [
            "SpawnItems",
            "WeaponMenu",
            "SpawnHealth",
            "Vampire"
        ],
        "Limits": {
            "Limit": "Logic-NOT",
            "Limits": {
                "Limit": "Map",
                "Regexp": "^(\\$|aim_|awp_|fy_|35hp_|1hp_|100hp_|he_|ka_)",
                "Real": true
            }
        }
    }
    // {...} Таких обьектов может быть сколько угодно
]
